{
  "name": "thebenzzcreations",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "assets:seo": "tsx scripts/generate-seo-assets.tsx",
    "sitemap:sync": "tsx scripts/sync-blog-sitemap.ts",
    "prebuild": "npm run content:check && npm run assets:seo && npm run discovery:generate && npm run schema:check && npm run seo:check",
    "predev": "npm run assets:seo",
    "test:seo": "tsx scripts/seo-check.mjs",
    "test:blog": "tsx scripts/blog-check.ts",
    "content:check": "tsx scripts/content-check.ts",
    "discovery:generate": "tsx scripts/generate-discovery.ts",
    "schema:check": "tsx scripts/validate-schema.ts",
    "seo:check": "tsx scripts/seo-audit.ts",
    "seo:check:built": "tsx scripts/seo-audit.ts --built",
    "postbuild": "npm run seo:check:built",
    "indexnow:ping": "tsx scripts/indexnow.ts",
    "lighthouse": "npx --yes --package=@lhci/cli@0.15.1 lhci autorun",
    "test:seo:browser": "node scripts/seo-browser.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.9.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "tsx": "^4.20.0",
    "playwright": "^1.58.0",
    "@axe-core/playwright": "^4.10.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
